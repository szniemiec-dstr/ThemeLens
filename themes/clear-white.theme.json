{
  "$schema": "./theme-1.schema.json",
  "id": "clear-white",
  "name": "Clear white",
  "description": "White page with near-black text",
  "base": "light",
  "roles": {
    "page": "#FFFFFF", "panel": "#F2F2F2",
    "text": "#111111", "quietText": "#595959",
    "link": "#1247A8", "good": "#1A5E28",
    "warning": "#744E00", "bad": "#A3221B"
  },
  "limits": {
    "maxLuminance": 1.0,
    "minTextContrast": 7.0
  },
  "keepBackground": "strict"
}
