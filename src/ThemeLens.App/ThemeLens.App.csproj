<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ThemeLensWindowsTfm)</TargetFramework>
    <!-- The oldest Windows the lens can run on: version 2004 (section 7.7). -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the icon in the notification area, which WPF does not have. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Windows Forms wants DPI awareness set its own way. This is a WPF app: the manifest and Program.Main settle it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <RootNamespace>ThemeLens.App</RootNamespace>
    <AssemblyName>ThemeLens.App</AssemblyName>
    <!-- Per-monitor DPI awareness v2, and no administrator rights (NFR-05). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>ThemeLens.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\ThemeLens.Platform.Windows\ThemeLens.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Program.Main starts the app, so that it can settle DPI awareness before WPF makes its first window. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <EmbeddedResource Update="Resources\Strings.resx" LogicalName="ThemeLens.App.Strings.resources" />
    <!-- Made from assets/icons by build/make-icons.cjs and build/make-icons.py. -->
    <Resource Include="Resources\*.ico" />
    <!-- Every file here means WPF when it says Application, Window or Button. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
