<!--
  The control window (section 4.6), as far as milestone M0 goes. It is an ordinary window that is kept above
  the lens and out of screen capture, so the lens never recolours it. Every text comes from Strings.resx.
-->
<Window x:Class="ThemeLens.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ThemeLens.App"
        xmlns:vm="clr-namespace:ThemeLens.App.ViewModels"
        Title="{x:Static app:Strings.AppTitle}"
        AutomationProperties.Name="{x:Static app:Strings.AppTitle}"
        Width="460"
        MinWidth="380"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Topmost="True"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="15"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24,20,24,24">

    <!-- Development mode: said first, and loudly. In it the lens does not behave as a user would expect. -->
    <Border x:Name="DevModeNotice"
            Margin="0,0,0,16"
            Padding="14,10"
            BorderBrush="{StaticResource Brush.Accent}"
            BorderThickness="2"
            CornerRadius="6"
            AutomationProperties.Name="{x:Static app:Strings.DevModeHeading}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDevMode}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.Accent}"
                   Text="{x:Static app:Strings.DevModeHeading}" />
        <TextBlock Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Text="{x:Static app:Strings.DevModeNote}" />
      </StackPanel>
    </Border>

    <!-- Title and status pill -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Text="{x:Static app:Strings.AppTitle}" />
      <TextBlock Grid.Column="1"
                 VerticalAlignment="Center"
                 Style="{StaticResource Quiet}"
                 AutomationProperties.Name="{x:Static app:Strings.FrameRateName}"
                 Text="{Binding FrameRateText}" />
    </Grid>

    <Border Margin="0,14,0,0"
            Padding="14,10"
            Background="{StaticResource Brush.Panel}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="2"
            CornerRadius="4">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot"
                   Width="10"
                   Height="10"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   Stroke="{StaticResource Brush.Accent}"
                   StrokeThickness="2">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLensOn}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <!-- A live region: a screen reader announces each change of state (section 4.8). -->
          <TextBlock x:Name="StatusLine"
                     Style="{StaticResource Label}"
                     TextWrapping="Wrap"
                     MaxWidth="360"
                     AutomationProperties.LiveSetting="Polite"
                     Text="{Binding StatusText}" />
        </StackPanel>
        <TextBlock Margin="20,6,0,0"
                   Text="{Binding StatusDetail}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusDetail}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Lens on or off -->
    <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Style="{StaticResource Label}"
                 Text="{x:Static app:Strings.LensLabel}" />
      <ToggleButton x:Name="LensSwitch"
                    Grid.Column="1"
                    MinWidth="96"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static app:Strings.LensSwitchName}"
                    IsChecked="{Binding IsLensOn, Mode=TwoWay}">
        <TextBlock>
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="{x:Static app:Strings.LensOff}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLensOn}" Value="True">
                  <Setter Property="Text" Value="{x:Static app:Strings.LensOn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </ToggleButton>
    </Grid>

    <!-- Theme -->
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Style="{StaticResource Label}"
                 Text="{x:Static app:Strings.ThemeLabel}" />
      <ComboBox x:Name="ThemeList"
                Grid.Column="1"
                AutomationProperties.Name="{x:Static app:Strings.ThemeLabel}"
                ItemsSource="{Binding ThemesView}"
                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ThemeChoice}">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
        <ComboBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Margin="14,12,14,4"
                           FontWeight="SemiBold"
                           Style="{StaticResource Quiet}"
                           Text="{Binding Name}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ComboBox.GroupStyle>
      </ComboBox>
    </Grid>

    <!-- Fill this screen, edit mode -->
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ToggleButton x:Name="FillButton"
                    Grid.Column="0"
                    AutomationProperties.Name="{x:Static app:Strings.FillScreen}"
                    Content="{x:Static app:Strings.FillScreen}"
                    IsChecked="{Binding FillsScreen, Mode=TwoWay}" />
      <ToggleButton x:Name="EditButton"
                    Grid.Column="2"
                    AutomationProperties.Name="{x:Static app:Strings.EditMode}"
                    AutomationProperties.HelpText="{x:Static app:Strings.EditModeHelp}"
                    Content="{x:Static app:Strings.EditMode}"
                    IsChecked="{Binding IsEditMode, Mode=TwoWay}" />
    </Grid>
    <TextBlock Margin="0,8,0,0"
               Style="{StaticResource Quiet}"
               Text="{x:Static app:Strings.EditModeHelp}" />

    <!-- The user's own values for the selected theme (FR-14). They change the lens while a slider moves. -->
    <TextBlock Margin="0,20,0,2"
               Style="{StaticResource Heading}"
               Text="{x:Static app:Strings.AdjustHeading}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="130" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static app:Strings.BrightnessLabel}" />
      <Slider x:Name="BrightnessSlider"
              Grid.Row="0"
              Grid.Column="1"
              AutomationProperties.Name="{x:Static app:Strings.BrightnessLabel}"
              Minimum="0.05"
              Maximum="1"
              SmallChange="0.01"
              LargeChange="0.1"
              Value="{Binding BrightnessLimit, Mode=TwoWay}" />
      <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource Label}" Text="{Binding BrightnessText}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static app:Strings.WarmthLabel}" />
      <Slider x:Name="WarmthSlider"
              Grid.Row="1"
              Grid.Column="1"
              AutomationProperties.Name="{x:Static app:Strings.WarmthLabel}"
              Minimum="0"
              Maximum="1"
              SmallChange="0.01"
              LargeChange="0.1"
              Value="{Binding Warmth, Mode=TwoWay}" />
      <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource Label}" Text="{Binding WarmthText}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static app:Strings.ContrastLabel}" />
      <Slider x:Name="ContrastSlider"
              Grid.Row="2"
              Grid.Column="1"
              AutomationProperties.Name="{x:Static app:Strings.ContrastLabel}"
              Minimum="0"
              Maximum="1"
              SmallChange="0.01"
              LargeChange="0.1"
              Value="{Binding Contrast, Mode=TwoWay}" />
      <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource Label}" Text="{Binding ContrastText}" />

      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="{x:Static app:Strings.SharpenLabel}" />
      <Slider x:Name="SharpenSlider"
              Grid.Row="3"
              Grid.Column="1"
              AutomationProperties.Name="{x:Static app:Strings.SharpenLabel}"
              Minimum="0"
              Maximum="1"
              SmallChange="0.01"
              LargeChange="0.1"
              Value="{Binding Sharpen, Mode=TwoWay}" />
      <TextBlock Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource Label}" Text="{Binding SharpenText}" />

      <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,0,0" Style="{StaticResource Label}" Text="{x:Static app:Strings.KeepBackgroundLabel}" />
      <ComboBox x:Name="KeepList"
                Grid.Row="4"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="0,6,0,0"
                AutomationProperties.Name="{x:Static app:Strings.KeepBackgroundLabel}"
                IsEnabled="{Binding CanKeepBackground}"
                ItemsSource="{Binding KeepChoices}"
                SelectedItem="{Binding SelectedKeep, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:KeepChoice}">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Button x:Name="ResetButton"
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Static app:Strings.ResetAdjustments}"
            Command="{Binding ResetAdjustmentsCommand}"
            Content="{x:Static app:Strings.ResetAdjustments}" />

    <!-- Keyboard shortcuts -->
    <TextBlock Margin="0,20,0,6"
               Style="{StaticResource Heading}"
               Text="{x:Static app:Strings.ShortcutsHeading}" />
    <ItemsControl x:Name="ShortcutList"
                  AutomationProperties.Name="{x:Static app:Strings.ShortcutsHeading}"
                  Focusable="False"
                  IsTabStop="False"
                  ItemsSource="{Binding Shortcuts}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:ShortcutRow}">
          <Grid Margin="0,3" AutomationProperties.Name="{Binding Spoken}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource Label}"
                       FontSize="14"
                       Text="{Binding Action}" />
            <TextBlock x:Name="Keys"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       Style="{StaticResource Label}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="{Binding Keys}" />
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSet}" Value="False">
              <Setter TargetName="Keys" Property="Foreground" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Keys" Property="FontStyle" Value="Italic" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Things worth knowing about this run -->
    <ItemsControl Margin="0,16,0,0"
                  Focusable="False"
                  IsTabStop="False"
                  ItemsSource="{Binding Notes}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Margin="0,3"
                     Style="{StaticResource Quiet}"
                     Text="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</Window>
