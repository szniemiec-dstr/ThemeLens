root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,props,targets,csproj,slnx,xaml,feature}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = false:suggestion
file_header_template = SPDX-License-Identifier: GPL-3.0-or-later

# Reqnroll generates code-behind for feature files.
[*.feature.cs]
generated_code = true
