<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Lets Linux and macOS compile the Windows-only projects (they still only run on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <ThemeLensTfm>net10.0</ThemeLensTfm>
    <ThemeLensWindowsTfm>net10.0-windows10.0.22621.0</ThemeLensWindowsTfm>

    <Version>0.1.0-dev</Version>
    <Product>ThemeLens</Product>
    <Authors>ThemeLens contributors</Authors>
    <Copyright>Copyright (C) ThemeLens contributors. Licensed under GPL-3.0-or-later.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
