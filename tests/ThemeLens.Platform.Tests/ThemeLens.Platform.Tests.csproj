<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows only: these tests need Direct3D and real windows. They build anywhere and skip themselves elsewhere. -->
    <TargetFramework>$(ThemeLensWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ThemeLens.Platform.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ThemeLens.Platform.Windows\ThemeLens.Platform.Windows.csproj" />
    <ProjectReference Include="..\ThemeLens.Testing\ThemeLens.Testing.csproj" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
