<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(ThemeLensTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ThemeLens.Specs</RootNamespace>
    <ReqnrollDeleteObsoleteCodeBehindFilesOnClean>true</ReqnrollDeleteObsoleteCodeBehindFilesOnClean>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ThemeLens.Core\ThemeLens.Core.csproj" />
    <ProjectReference Include="..\..\src\ThemeLens.Engine\ThemeLens.Engine.csproj" />
    <ProjectReference Include="..\ThemeLens.Testing\ThemeLens.Testing.csproj" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="Reqnroll" />
  </ItemGroup>
</Project>
