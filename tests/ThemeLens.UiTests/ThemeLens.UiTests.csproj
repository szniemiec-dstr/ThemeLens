<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows only: these tests start the app and drive it through UI Automation. They build anywhere and skip themselves elsewhere. -->
    <TargetFramework>$(ThemeLensWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ThemeLens.UiTests</RootNamespace>
    <!-- The tests ask Windows a few questions directly (user32), and the generated calls are unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- The UI Automation library needs the Windows desktop runtime even to start. Elsewhere this project is
         built, so that it keeps compiling, but "dotnet test" leaves it alone. -->
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app is started as a program, not loaded, so it is not referenced. Build the solution first. -->
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
